# ---------------------------------------------------------------------------
# RL Jewels Photo Studio - environment configuration
#
# Copy to .env for local development. In production set these in your hosting
# provider's dashboard instead of shipping a .env file.
#
# The two REQUIRED values below are enforced: with NODE_ENV=production the
# server refuses to start without them, rather than falling back to an
# insecure default the way v1 did.
# ---------------------------------------------------------------------------

# === REQUIRED IN PRODUCTION ===

# Signs the staff session cookie. Any long random string - but it must stay
# FIXED. If it changes, every signed-in staff member is logged out.
#   Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Creates the first admin account, once, on an empty database. After that,
# accounts are managed in the app's Admin screen and this value is unused.
# Minimum 10 characters.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin


# === CORE ===

# Where the database and every photo are stored. MUST be a persistent volume
# in production - lose this directory and you lose the shoot.
DATA_DIR=./data-store

PORT=3000

# Required for any AI processing. Without it photos still capture and queue,
# and the app says so plainly, but nothing gets processed.
GEMINI_API_KEY=

# How many photos process at once. Each job is several sequential Gemini
# calls, so this is about API rate limits, not CPU. Raise it once you know
# your real quota.
QUEUE_CONCURRENCY=2


# === ERP EXPORT ===

# Which column layout exports use: generic | odoo | shopify, or the id of a
# JSON file you drop into <DATA_DIR>/mappings/.
#
# "generic" is the honest default. v1 hardcoded Odoo's field names on an
# assumption nobody confirmed - set this to your real system once you know it.
ERP_MAPPING=generic


# === OPTIONAL INTEGRATIONS ===
# Each stays switched off, and hidden in the UI, until its variables are set.

# Tag text scanning. Free tier at ocr.space. Barcode and QR scanning work
# without this; only OCR of printed tag text needs it.
OCR_SPACE_API_KEY=

# Google Drive photo export. See DRIVE_SETUP.md for the one-time OAuth steps.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Tethered studio camera. See DSLR_CAPTURE_SETUP.md.
DSLR_BRIDGE_URL=
DSLR_BRIDGE_SECRET=

# Axiom log mirror. Optional now that the local event log is durable - useful
# as a second place to look and for ad-hoc querying. See LOGGING_SETUP.md.
AXIOM_TOKEN=
AXIOM_DATASET=rl-jewels-events


# === COST CALIBRATION ===
# Per-call USD rates used by the Insights dashboard. The built-in defaults are
# PLACEHOLDERS, and the dashboard says so until these are set. After a pilot
# run, read your real figures off the Cloud Billing console and set them here
# so the cost numbers mean something.
COST_ENHANCE_DEFAULT_USD=
COST_ENHANCE_ESCALATED_USD=
COST_AUDIT_USD=
COST_SEGMENT_USD=
COST_COPY_USD=


# === LOGIN LOCKOUT ===
# Brute-force protection on the sign-in endpoint. Defaults are sensible; these
# exist for tuning, not for turning it off.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
